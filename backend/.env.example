# Project ROS2 runtime settings. install.sh and start.sh synchronize these
# values to /etc/ros2-dashboard/dashboard.env for the systemd Monitor.
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Public FastAPI backend settings
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
MONITOR_BASE_URL=http://127.0.0.1:8765
MONITOR_TIMEOUT_SEC=30
MONITOR_POLL_INTERVAL_SEC=1
USER_PREFERENCES_PATH=config/user_preferences.yaml

# MariaDB Alert history. Keep the password only in backend/.env or the
# deployment secret store; never commit the real value.
ALERT_DB_ENABLED=true
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
# Optional local Unix socket. Leave empty for TCP host/port.
MARIADB_UNIX_SOCKET=
MARIADB_DATABASE=ros2_dashboard
MARIADB_USER=ros2_dashboard
MARIADB_PASSWORD=
MARIADB_CONNECT_TIMEOUT_SEC=2
MARIADB_RETRY_INTERVAL_SEC=5

# ROS2 Monitor settings belong to the Monitor process. Export these before
# `ros2 run ros2_dashboard_monitor monitor` only when overriding defaults.
# ROS2_MONITOR_HOST=127.0.0.1
# ROS2_MONITOR_PORT=8765
# ROS2_DASHBOARD_MONITOR_CONFIG_DIR=src/ros2_dashboard_monitor/config
