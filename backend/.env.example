# Public FastAPI backend settings
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MONITOR_BASE_URL=http://127.0.0.1:8765
MONITOR_TIMEOUT_SEC=30
MONITOR_POLL_INTERVAL_SEC=1
USER_PREFERENCES_PATH=config/user_preferences.yaml

# ROS2 Monitor settings belong to the Monitor process. Export these before
# `ros2 run ros2_dashboard_monitor monitor` only when overriding defaults.
# ROS2_MONITOR_HOST=127.0.0.1
# ROS2_MONITOR_PORT=8765
# ROS2_DASHBOARD_MONITOR_CONFIG_DIR=src/ros2_dashboard_monitor/config
