# Optional primary LAN IPv4 override. Leave empty to use the active default route.
DASHBOARD_LOCAL_IP=

# `auto` replaces copied/stale IP values with current active LAN IPv4 addresses
# while retaining valid DNS names. Use `manual` only to preserve server_name exactly.
DASHBOARD_SERVER_NAME_MODE=auto

# Local listener and optional DNS names. Auto mode supplies localhost and LAN IPs.
DASHBOARD_HTTPS_PORT=443
DASHBOARD_SERVER_NAME=

# Absolute paths on the local PC. Do not commit the certificate files.
DASHBOARD_TLS_CERTIFICATE=/etc/nginx/ssl/ros2-dashboard.crt
DASHBOARD_TLS_PRIVATE_KEY=/etc/nginx/ssl/ros2-dashboard.key

# Production static frontend and local FastAPI upstream
DASHBOARD_FRONTEND_ROOT=/var/lib/ros2-dashboard/frontend
DASHBOARD_BACKEND_UPSTREAM=http://127.0.0.1:8000
