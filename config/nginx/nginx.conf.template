map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen ${DASHBOARD_HTTPS_PORT} ssl;
    listen [::]:${DASHBOARD_HTTPS_PORT} ssl;
    server_name ${DASHBOARD_SERVER_NAME};

    ssl_certificate ${DASHBOARD_TLS_CERTIFICATE};
    ssl_certificate_key ${DASHBOARD_TLS_PRIVATE_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;

    root ${DASHBOARD_FRONTEND_ROOT};
    index index.html;

    location = /ws/monitor {
        proxy_pass ${DASHBOARD_BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
    }

    location = /health {
        proxy_pass ${DASHBOARD_BACKEND_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /ros/ {
        proxy_pass ${DASHBOARD_BACKEND_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
