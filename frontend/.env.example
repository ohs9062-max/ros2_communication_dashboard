# Topic 목록, health, Topic Alert, 선택 Topic 상세의 갱신 주기입니다.
VITE_TOPIC_POLL_INTERVAL_MS=1000

# Service, Action, Node Dashboard와 관련 관계/Alert의 갱신 주기입니다.
VITE_DASHBOARD_POLL_INTERVAL_MS=3000

# Visualization에서 네 리소스 목록을 다시 읽는 주기입니다.
VITE_VISUALIZATION_POLL_INTERVAL_MS=5000

# 기존 API 주소 설정입니다. WebSocket 주소도 이 값을 ws/wss로 변환해 사용합니다.
VITE_API_BASE_URL=http://127.0.0.1:8000
