<?xml version="1.0"?>
<package format="3">
  <name>rths_interfaces</name>
  <version>0.0.0</version>
  <description>Demo interfaces used by ros2_dashboard communication tests.</description>
  <maintainer email="geniusnada@todo.todo">geniusnada</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Interface generation -->
  <build_depend>rosidl_default_generators</build_depend>

  <!-- Runtime support for generated interfaces -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Required marker for interface packages -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
